# Python
__pycache__/
*.py[cod]
*.so
venv/
.venv/
db.sqlite3
db.sqlite3-journal
staticfiles/
media/

# Git / VCS
.git/
.gitignore

# Environment & secrets
.env
.env.production
opencode.json

# Frontend
node_modules/
frontend/node_modules/
frontend/dist/

# Datasets, training runs, test media, and the syn_eval benchmark -- never
# needed inside the image. Without this, `COPY . .` pulls ~1.9GB into every
# build.
data/

# Model weights: pretrained_weights/ is required at runtime, but the 233MB
# legacy lapi.weights is not -- exclude just that.
pretrained_weights/lapi.weights

# Tooling
.idea/
.vscode/
*.log

# OS
.DS_Store
Thumbs.db

# Docker build artifacts (avoid copying host-built images/dist)
*.whl
