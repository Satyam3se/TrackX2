# ============================================================================
# TrackX — Environment template
# Copy to `.env` for local Docker Compose (docker compose up --build reads .env)
# ============================================================================

# ---------- Postgres / PostGIS ----------
POSTGRES_DB=trackx_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=trackx_pass

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Django ----------
# Generate with:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=0

# ---------- Frontend / SPA ----------
# URL of the React SPA (the single TrackX command center).
# Docker Compose frontend (nginx) serves it at :3000 by default.
# For local Vite dev server, set to http://localhost:5173/
REACT_APP_URL=http://localhost:3000/