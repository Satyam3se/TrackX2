# All defaults are SAME-ORIGIN: they work through the Vite dev proxy
# (frontend/vite.config.js -> http://localhost:8000) and through the Nginx
# reverse proxy in production. Set these ONLY when the backend truly lives on
# a different host than the UI.

# VITE_API_BASE_URL=/api/v1
# VITE_WS_URL=/ws/alerts/
# VITE_WS_LIVE_URL=/ws/live-video/

# Optional: point the Vite dev proxy at a non-default backend.
# VITE_DEV_BACKEND=http://localhost:8000