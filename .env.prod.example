# ============================================================================
# TrackX — FREE production env template (VPS + Caddy + DuckDNS, $0/mo)
# Copy to .env on the server, then fill in the two required values.
#   cp .env.prod.example .env
# ============================================================================

# --- REQUIRED: generate once, e.g. `openssl rand -hex 32` -------------------
DJANGO_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
DJANGO_DEBUG=0

# --- REQUIRED: your free public name, e.g. trackx-demo.duckdns.org -----------
# Get one free at https://www.duckdns.org (no card, points at your VM IP).
PUBLIC_HOST=trackx-demo.duckdns.org
ALLOWED_HOSTS=trackx-demo.duckdns.org

# --- Database (internal to compose, keep defaults or change password) --------
POSTGRES_DB=trackx_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-db-password

# --- Frontend build args (relative paths work behind Caddy, leave as-is) -----
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=
